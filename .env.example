# Copie este arquivo para `.env` e preencha com as credenciais reais.
# As mesmas variaveis precisam existir no painel da Vercel (Settings > Environment Variables).

# --- Supabase ---
# A anon key e publica por design (o navegador precisa dela).
# A protecao real vem das policies de RLS no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- APIs externas ---
# ATENCAO: variaveis com prefixo VITE_ sao embutidas no bundle do navegador
# em tempo de build, ou seja, ficam visiveis para qualquer visitante do site.
# Nao coloque aqui nenhuma chave que nao possa ser publica.
VITE_API_FOOTBALL_KEY=
VITE_THESPORTSDB_KEY=

# --- Somente servidor (Vercel Functions) ---
# Sem o prefixo VITE_, portanto NAO vai para o bundle do cliente.
# Usada em api/highlights.js. Definir apenas na Vercel.
YOUTUBE_API_KEY=
